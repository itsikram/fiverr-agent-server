# fiverr-server — copy to .env and fill in values
# Loaded by src/config/env.js via dotenv

# HTTP listen port (Render sets PORT automatically)
PORT=8765

# Set true on Render / production hosts
# RENDER=true
# RENDER_EXTERNAL_URL=https://fiverr-agent-server.onrender.com

# MySQL (Prisma) — create the tables with: npm run db:push
DB_HOST=localhost
DB_PORT=3306
DB_NAME=fiverr_agent
DB_USER=fiverr
DB_PASSWORD=change-me

# Optional: used by MessageServerClient helpers
SERVER_URL=http://localhost:8765
# LIVE_SERVER_WS_URL=ws://localhost:8765

# Web Push (VAPID) — required for Expo web / PWA notifications when the app is closed
# Generate with: node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=BNU6DkAj82gLV8W6BG4c7rEBxBbQo_j3kfb39x8KowjXR1Wq3RCmYxYpIzwYbSm8WSn5H2QFqCfYqcksTd6PyRw
VAPID_PRIVATE_KEY=ylhdnhdbYA9aKnQT5XvhZAOfTPcSUXcNvi-Y3nkU6Go
VAPID_SUBJECT=mailto:admin@fiverr-agent.local
