# fiverr-server — copy to .env and fill in values
# Loaded by server.js / mongo.js via dotenv

# HTTP listen port (Render sets PORT automatically)
PORT=8765

# Set true on Render / production hosts
# RENDER=true
# RENDER_EXTERNAL_URL=https://fiverr-agent-server.onrender.com

# MongoDB
MONGODB_URL=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/fiverr_agent?appName=Cluster0
# Aliases also accepted: MONGODB_URI, mongodb_url
MONGODB_DB_NAME=fiverr_agent

# Optional collection overrides
# MONGODB_PROFILES_COLLECTION=seller_profiles
# MONGODB_CLIENTS_COLLECTION=clients
# MONGODB_MESSAGES_COLLECTION=messages
# MONGODB_USERS_COLLECTION=users

# Optional: used by MessageServerClient helpers
SERVER_URL=http://localhost:8765
# LIVE_SERVER_WS_URL=ws://localhost:8765
